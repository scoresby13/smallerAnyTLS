#!/bin/sh /etc/rc.common

USE_PROCD=1
START=90
STOP=10

PROG=/usr/bin/anytls-tiny
CONF=anytls

start_service() {
    config_load "$CONF"
    
    local enabled server port password sni socks_port redir_port dns_port
    config_get_bool enabled main enabled 0
    [ "$enabled" -eq 1 ] || return 0
    
    config_get server main server ""
    config_get port main port "443"
    config_get password main password ""
    config_get sni main sni ""
    config_get socks_port main socks_port "1080"
    config_get redir_port main redir_port "1100"
    config_get dns_port main dns_port "5353"
    
    [ -n "$server" ] && [ -n "$password" ] || {
        echo "[anytls] Error: server and password must be configured in /etc/config/anytls" >&2
        return 1
    }
    
    [ -n "$sni" ] || sni="$server"
    
    procd_open_instance
    procd_set_param command "$PROG" \
        -s "$server" \
        -p "$port" \
        -k "$password" \
        -h "$sni" \
        -l "$socks_port" \
        -r "$redir_port" \
        -u "$dns_port"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall anytls-tiny 2>/dev/null
}

reload_service() {
    stop
    start
}
