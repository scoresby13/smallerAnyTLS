#!/bin/sh /etc/rc.common

USE_PROCD=1
START=90
STOP=10

PROG=/usr/bin/anytls-tiny
CONF=anytls

start_service() {
    config_load "$CONF"

    local enabled server port password sni socks_port redir_port dns_port dns_server listen_addr
    local max_sessions idle_timeout min_idle
    config_get_bool enabled main enabled 0
    [ "$enabled" -eq 1 ] || return 0

    config_get server main server ""
    config_get port main port "443"
    config_get password main password ""
    config_get sni main sni ""
    config_get socks_port main socks_port "1080"
    config_get redir_port main redir_port "1100"
    config_get dns_port main dns_port "5353"
    config_get dns_server main dns_server "8.8.8.8:53"
    config_get listen_addr main listen_addr "0.0.0.0"
    config_get max_sessions main max_sessions "8"
    config_get idle_timeout main idle_timeout "60"
    config_get min_idle main min_idle "1"

    [ -n "$server" ] && [ -n "$password" ] || {
        echo "[anytls] Error: server and password must be configured in /etc/config/anytls" >&2
        return 1
    }

    [ -n "$sni" ] || sni="$server"

    procd_open_instance
    procd_set_param command "$PROG" \
        -s "$server" \
        -p "$port" \
        -k "$password" \
        -h "$sni" \
        -l "$socks_port" \
        -r "$redir_port" \
        -u "$dns_port" \
        -n "$dns_server" \
        -b "$listen_addr" \
        -m "$max_sessions" \
        -i "$idle_timeout" \
        -w "$min_idle"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "$CONF"
}
