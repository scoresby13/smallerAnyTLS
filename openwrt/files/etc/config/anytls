config anytls 'main'
	option enabled '0'
	option server 'your-server.example.com'
	option port '443'
	option password 'your-uuid-or-password'
	option sni 'your-sni.example.com'
	option socks_port '1080'
	option redir_port '1100'
	option dns_port '5353'
	# Resolver queried through the tunnel (IPv4[:port])
	option dns_server '8.8.8.8:53'
	# Listen address for SOCKS5 and DNS; use '127.0.0.1' if only the router needs them
	option listen_addr '0.0.0.0'
	# Session pool: at most max_sessions TLS connections to the server (1-32,
	# each costs RAM); idle ones close after idle_timeout seconds, except the
	# newest min_idle, which stay open so new connections start instantly
	option max_sessions '8'
	option idle_timeout '60'
	option min_idle '1'
